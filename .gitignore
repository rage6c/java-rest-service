.env
.env.*
!.env.example
!.env.sample
*.jks
*.keystore
*.p12
*.pfx

# Logs and runtime diagnostics
logs/
*.log
*.hprof
hs_err_pid*
replay_pid*

# Python generator caches
__pycache__/
*.py[cod]
.venv/
venv/

# Operating-system metadata
.DS_Store
._*
Thumbs.db
Desktop.ini
